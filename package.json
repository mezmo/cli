{
  "name": "@mezmo/cli",
  "version": "2.1.0",
  "scripts": {
    "version": "cat package.json | awk '/\"version\"/ {gsub(/[\",]/,\"\"); print $2; exit}'",
    "clean": "rm -rf dist mzm coverage",
    "setup": "mkdir -p dist",
    "prerelease": "rm -rf dist && mkdir dist",
    "release": "semantic-release",
    "release:dry": "semantic-release --dry-run --no-ci --branches=${BRANCH_NAME:-main}",
    "test": "bun test --coverage-reporter=text --coverage-reporter=lcov --reporter=junit --reporter-outfile=coverage/test.xml",
    "typecheck": "tsc --noEmit",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/bun": "latest",
    "@types/node": "^24.2.0",
    "@types/web": "^0.0.281",
    "semantic-release": "^25.0.2",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "workspaces": [
    "@mzm/*"
  ],
  "dependencies": {
    "@mzm/command-ask": "workspace:*",
    "@mzm/command-config": "workspace:*",
    "@mzm/command-create": "workspace:*",
    "@mzm/command-delete": "workspace:*",
    "@mzm/command-edit": "workspace:*",
    "@mzm/command-get": "workspace:*",
    "@mzm/command-log": "workspace:*",
    "@mzm/command-upgrade": "workspace:*",
    "@mzm/command-version": "workspace:*",
    "@mzm/config": "workspace:*",
    "@mzm/core": "workspace:*"
  }
}
